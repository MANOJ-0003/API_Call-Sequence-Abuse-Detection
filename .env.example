# ─────────────────────────────────────────────────────────────────────────────
#  API Sentinel  –  Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP (Email Notifications) ───────────────────────────────────────────────
#  Without these variables the app runs in DEMO MODE:
#  OTPs and login alerts are printed to the console instead of emailed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM=your-address@gmail.com
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── Twilio SMS (optional step-up OTP via SMS) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_PHONE=+1234567890

# ── Flask (optional overrides) ───────────────────────────────────────────────
# FLASK_ENV=development
# SECRET_KEY=change-me-in-production
